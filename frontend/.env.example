# API Configuration
# The BROWSER, not any container, is the consumer — keep this on localhost:8123
# even when running via `make docker-up`. The backend publishes port 8123 on the
# host, so the browser's origin is identical in host-mode and compose-mode.
VITE_API_BASE_URL=http://localhost:8123
# Same browser-is-consumer rule applies to the WebSocket endpoint — keep this
# on localhost:8123 in compose-mode too.
VITE_WS_URL=ws://localhost:8123/agents/stream

# Feature Flags
VITE_ENABLE_AGENT_CHAT=true
VITE_ENABLE_ADMIN_PANEL=true

# Visualization
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_CHART_POINTS=365
